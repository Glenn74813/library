# Copy to .env and choose every value before the first start.
# Database password (any long random string).
DB_PASSWORD=
# Token signing key: a long random string of at least 32 characters, e.g. from `openssl rand -base64 48`.
JWT_SECRET=
# First administrator's password, used once on an empty database (must be changed at first sign-in).
# Leave empty to have a random one generated and printed once in the API log.
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:8081
# SIP2 self-check stations on the library LAN: this PC's LAN address (default: this PC only).
#SIP_BIND=192.168.1.10
